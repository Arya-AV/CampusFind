# CampusFind Environment Configuration
# Copy this file to .env and customize for your environment:
#   cp .env.example .env

# Flask Secret Key for session signing and cryptographic security.
# For production, generate a secure random 32-byte key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Flask Debug Mode: 0 (default/production) or 1 (local development only)
FLASK_DEBUG=0

# Server host and port (optional)
# HOST=127.0.0.1
# PORT=5000

